{
  "tool_id": "line_modifier",
  "tool_name": "精准文件行数修改",
  "description": "修改指定文件的指定行范围内容；单次最多修改 40 行、写入 4000 字符。⚠️ 重要：文件必须已存在！如需创建新文件请使用 create_file。需要检查json格式是否被破坏",
  "trigger": "当需要小块、精准地修改文件特定行内容时使用；禁止用于整文件写入,如果文件不存在，请先调用 create_file。",
  "parameters": {
    "type": "object",
    "required": ["filepath", "start_line", "end_line", "new_content"],
    "properties": {
      "filepath": {
        "type": "string"
      },
      "start_line": {
        "type": "integer",
        "minimum": 1
      },
      "end_line": {
        "type": "integer",
        "minimum": 1
      },
      "new_content": {
        "type": "string",
        "maxLength": 4000
      }
    }
  },
  "policy": {
    "max_target_lines": 40,
    "max_content_lines": 40,
    "max_content_chars": 4000
  },
  "param_descriptions": {},
  "permission_level": "confirm",
  "permission_message": "是否允许修改文件 {filepath} 的第 {start_line} 到 {end_line} 行？",
  "script_path": ".tool/tools/line_modifier/run.py",
  "category": "文件操作",
  "tags": [
    "文件修改",
    "精准行数"
  ]
}
