{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "NetMind": "Information"
        }
    },
    "AppLogging": {
        "FileEnabled": true,
        "Directory": "Logs"
    },
    "AiClean": {
        "Prompt": {
            "ContextCompressionThreshold": 4000,
            "PromptFiles": {
                "System": "Config/AiCleanPrompts/system.prompt.md",
                "User": "Config/AiCleanPrompts/mind-map-clean.prompt.md",
                "Requirement": "Config/AiCleanPrompts/requirement-structure.prompt.md",
                "ContextChat": "Config/AiCleanPrompts/context-chat.prompt.md",
                "ContextCompression": "Config/AiCleanPrompts/context-compression.prompt.md",
                "NodeChat": "Config/AiCleanPrompts/node-chat.prompt.md",
                "NodeChatCompression": "Config/AiCleanPrompts/node-chat-compression.prompt.md",
                "MapChat": "Config/AiCleanPrompts/map-chat.prompt.md",
                "AppHelp": "Config/AiCleanPrompts/app-help.prompt.md",
                "AppManual": "Config/AiCleanPrompts/directions-help.prompt.md"
            }
        },
        "Models": [
            {
                "Id": "deepseek-cloud",
                "Name": "DeepSeek Cloud",
                "Provider": "deepseek",
                "Endpoint": "https://api.deepseek.com/chat/completions",
                "Model": "deepseek-v4-flash",
                "Enabled": true,
                "IsDefault": true,
                "ApiKeyEnvironmentVariable": "DEEPSEEK_API_KEY",
                "TimeoutSeconds": 60,
                "Notes": "默认云模型。运行前请在环境变量 DEEPSEEK_API_KEY 中配置密钥，仓库配置不保存明文 Key。"
            },
            {
                "Id": "ollama-local",
                "Name": "Ollama Local",
                "Provider": "ollama",
                "Endpoint": "http://127.0.0.1:11434/api/chat",
                "Model": "qwen3.5:9b",
                "Enabled": true,
                "IsDefault": false,
                "TimeoutSeconds": 1200,
                "Notes": "本地备用模型。需要本机 Ollama 服务运行，并已拉取配置的模型。"
            }
        ]
    },
    "AiAgent": {
        "AgentBuildPath": "G:\\AAW+\\NetMind\\AgentBuild",
        "PythonExecutable": "py",
        "TimeoutSeconds": 120,
        "Temperature": 0.2,
        "MaxTokens": 4096,
        "MaxRetries": 2,
        "NetMindApiBaseUrl": "http://127.0.0.1:5120",
        "SkillRuntimeTimeoutSeconds": 10,
        "NodeQuestion": {
            "DomainAndSkillBinding": "default",
            "IdentityLines": [
                "你是 NetMind 的节点问答 Agent，负责围绕当前选中节点、父节点链、子节点、关联节点和对话历史回答用户问题。",
                "你可以根据 AgentBuild 当前 domain_and_skill_binding 暴露的 Skill 提出工具调用，但不直接修改 NetMind 数据库。"
            ],
            "CuesLines": [
                "使用中文回答，先给用户可直接阅读的结论，再补充必要依据。",
                "如果需要调用 Skill，只能输出 Agent Kernel 要求的 skill_call_drafts，由 Kernel 做权限校验。",
                "当前 domain_and_skill_binding 固定使用 default。"
            ]
        },
        "MapQuestion": {
            "DomainAndSkillBinding": "default",
            "IdentityLines": [
                "你是 NetMind 的全图问答 Agent，负责围绕当前思维导图的全量节点、节点内容、层级结构、关联关系和对话历史回答用户问题。",
                "你可以根据 AgentBuild 当前 domain_and_skill_binding 暴露的 Skill 提出工具调用，但不直接修改 NetMind 数据库。"
            ],
            "CuesLines": [
                "使用中文回答，先给用户可直接阅读的结论，再补充必要依据。",
                "全图问答会收到当前导图的完整 nodes 与 relations；回答时优先基于这些结构化数据，不要编造未提供的节点或关系。",
                "如果需要调用 Skill，只能输出 Agent Kernel 要求的 skill_call_drafts，由 Kernel 做权限校验。"
            ]
        },
        "GlobalQuestion": {
            "DomainAndSkillBinding": "default",
            "IdentityLines": [
                "你是 NetMind 的全局问答 Agent，负责在不读取具体节点或思维导图数据的前提下回答用户的全局性问题。",
                "你可以根据 AgentBuild 当前 domain_and_skill_binding 暴露的 Skill 提出工具调用，但不直接修改 NetMind 数据库。"
            ],
            "CuesLines": [
                "使用中文回答，先给用户可直接阅读的结论，再补充必要依据。",
                "全局问答只会收到基础应用信息、对话历史和 Agent 记忆；不得假设存在未传入的节点、关联或思维导图内容。",
                "如果问题需要具体导图或节点数据，请明确说明当前模式没有收到这些数据，并建议切换到节点问答或全图问答。"
            ]
        }
    },
    "AllowedHosts": "*"
}
